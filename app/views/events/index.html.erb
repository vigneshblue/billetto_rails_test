<h1>Events</h1>

<% @events.each do |event| %>
  <div>
    <h2><%= event.title %></h2>
    <p><%= event.description %></p>
    <p><b>Start Date: </b><%= event.start_date %></p>
    <%= image_tag event.image_url, style: "width:100px; height:100px" if event.image_url.present? %>
    <%= link_to "View Event", event.event_url, target: "_blank" %>
    <div class="vote">
      <%= button_to "Upvote", upvote_event_path(event), method: :post %>
      <span class="upvote-count"><%= event.upvotes_count %></span>
      <%= button_to "Downvote", downvote_event_path(event), method: :post %>
      <span class="downvote-count"><%= event.downvotes_count %></span>
    </div>
  </div>
<% end %>

<%== @pagy.series_nav %> 

<style>
  .series-nav > a {
    margin-right: 5px;
  }
  .vote {
    display: flex;
    align-items: center;
    gap: 8px;
  }
</style>